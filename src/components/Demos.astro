---
import Icon from './Icon.astro';
import { demos } from '../data/demos';
---
<section id="demos" class="container-home scroll-mt-20 pt-12 pb-16">
  <div class="flex items-end justify-between gap-4 border-b border-line pb-4">
    <div>
      <p class="eyebrow">01 · Demos</p>
      <h2 class="section-title mt-2">Robots in Action</h2>
    </div>
    <a href="https://www.youtube.com/PouryaShahverdi" target="_blank" rel="noopener noreferrer" class="hidden text-sm text-muted hover:text-fg sm:inline-flex sm:items-center sm:gap-1">
      YouTube channel <Icon name="arrowUpRight" size={14} />
    </a>
  </div>

  <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {demos.map((d, i) => {
      const featured = i === 0;
      return (
        <li class:list={[featured && 'sm:col-span-2 lg:col-span-3']}>
          <button
            type="button"
            class:list={[
              'demo-card group card w-full overflow-hidden text-left transition-colors hover:border-fg/30',
              featured ? 'grid lg:grid-cols-[3fr_2fr]' : 'block',
            ]}
            data-youtube={d.youtubeId}
            data-title={d.title}
            aria-label={`Play video: ${d.title}`}
          >
            <div
              class:list={[
                'relative aspect-video overflow-hidden bg-line',
                featured ? 'border-b border-line lg:border-r lg:border-b-0' : 'border-b border-line',
              ]}
            >
              <img
                src={`https://i.ytimg.com/vi/${d.youtubeId}/${featured ? 'maxresdefault' : 'hqdefault'}.jpg`}
                alt=""
                loading={featured ? 'eager' : 'lazy'}
                decoding="async"
                width={featured ? 1280 : 480}
                height={featured ? 720 : 360}
                onerror={featured ? `this.onerror=null;this.src='https://i.ytimg.com/vi/${d.youtubeId}/hqdefault.jpg'` : undefined}
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
              />
              <span class="absolute inset-0 flex items-center justify-center">
                <span
                  class:list={[
                    'flex items-center justify-center rounded-full bg-white/90 text-gray-900 shadow-sm ring-1 ring-black/5 transition-transform group-hover:scale-105',
                    featured ? 'h-14 w-14' : 'h-11 w-11',
                  ]}
                >
                  <Icon name="play" size={featured ? 22 : 18} />
                </span>
              </span>
            </div>
            {featured ? (
              <div class="flex flex-col justify-center gap-3 p-6 lg:p-8">
                <span class="eyebrow">Featured · Latest study</span>
                <h3 class="text-xl font-semibold leading-snug tracking-[-0.02em] sm:text-2xl">{d.title}</h3>
                <span class="badge w-fit">{d.venue}</span>
                <span class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
                  <Icon name="play" size={13} /> Watch demo
                </span>
              </div>
            ) : (
              <div class="flex items-start justify-between gap-3 p-4">
                <h3 class="text-[15px] font-medium leading-snug">{d.title}</h3>
                <span class="badge shrink-0">{d.venue}</span>
              </div>
            )}
          </button>
        </li>
      );
    })}
  </ul>

  <dialog
    id="video-modal"
    class="m-auto w-[min(960px,calc(100vw-2rem))] max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
    aria-label="Demo video"
  >
    <div class="mb-2 flex items-center justify-between gap-4 text-white">
      <p id="video-modal-title" class="truncate text-sm font-medium"></p>
      <button type="button" id="video-modal-close" class="inline-flex h-8 w-8 items-center justify-center rounded-md text-white/80 hover:bg-white/10 hover:text-white" aria-label="Close video">
        <Icon name="close" size={18} />
      </button>
    </div>
    <div id="video-modal-frame" class="aspect-video w-full overflow-hidden rounded-lg bg-black"></div>
  </dialog>
</section>

<script>
  const modal = document.getElementById('video-modal') as HTMLDialogElement | null;
  const frame = document.getElementById('video-modal-frame');
  const titleEl = document.getElementById('video-modal-title');
  const closeBtn = document.getElementById('video-modal-close');

  function close() {
    modal?.close();
  }

  modal?.addEventListener('close', () => {
    if (frame) frame.innerHTML = '';
    document.documentElement.style.overflow = '';
  });
  // click on backdrop closes
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });
  closeBtn?.addEventListener('click', close);

  document.querySelectorAll<HTMLButtonElement>('.demo-card').forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.dataset.youtube;
      if (!id || !modal || !frame) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0`;
      iframe.title = card.dataset.title ?? 'Demo video';
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.loading = 'lazy';
      iframe.className = 'h-full w-full';
      frame.replaceChildren(iframe);
      if (titleEl) titleEl.textContent = card.dataset.title ?? '';
      document.documentElement.style.overflow = 'hidden';
      modal.showModal();
    });
  });
</script>
